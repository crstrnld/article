<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Aplikasi CRUD</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="container">
        <h1><%= title %></h1>
        <a href="/" class="btn btn-secondary">Kembali ke Beranda</a>
        
        <% if (message) { %>
            <div class="alert success"><%= message %></div>
        <% } %>
        
        <% if (error) { %>
            <div class="alert error"><%= error %></div>
        <% } %>
        
        <div style="margin: 30px 0;">
            <div style="background: #f8f9fa; padding: 30px; border-radius: 10px; text-align: center; border: 2px solid #007bff;">
                <h2>Total Pengguna</h2>
                <p style="font-size: 4rem; font-weight: bold; color: #007bff;">
                    <%= stats.totalUsers %>
                </p>
                <p>orang terdaftar</p>
            </div>
        </div>

        <h2>Pengguna Terbaru</h2>
        <% if (stats.latestUsers && stats.latestUsers.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Nama</th>
                        <th>Email</th>
                        <th>Telepon</th>
                        <th>Tanggal Daftar</th>
                    </tr>
                </thead>
                <tbody>
                    <% stats.latestUsers.forEach((user, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= user.nama %></td>
                            <td><%= user.email %></td>
                            <td><%= user.telepon || '-' %></td>
                            <td><%= new Date(user.createdAt).toLocaleDateString('id-ID') %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <div class="empty">
                <p>Tidak ada data pengguna</p>
            </div>
        <% } %>
    </div>
</body>
</html>