#!/usr/bin/env node

/**
 * Module dependencies.
 */
require('dotenv').config();
const app = require('../app');

/**
 * Get port from environment and store in Express.
 */
const port = process.env.PORT || 3000;
app.set('port', port);

/**
 * Create HTTP server.
 */
const http = require('http');
const server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */
server.listen(port, async () => {
    console.log('='.repeat(50));
    console.log('🚀 SERVER NODE.JS DENGAN SQLite');
    console.log('='.repeat(50));
    console.log(`🌐 Server berjalan di: http://localhost:${port}`);
    console.log(`📁 Mode: ${process.env.NODE_ENV || 'development'}`);
    console.log('='.repeat(50));
    
    // Setup database
    try {
        const { setupDatabase } = require('../prisma/client');
        console.log('🔧 Menyiapkan database...');
        const result = await setupDatabase();
        if (result.success) {
            console.log('✅ Database siap!');
        } else {
            console.log('⚠️ Database warning:', result.error);
        }
    } catch (error) {
        console.log('⚠️ Database error, but server continues:', error.message);
    }
});

server.on('error', (error) => {
    if (error.syscall !== 'listen') {
        throw error;
    }

    const bind = typeof port === 'string'
        ? 'Pipe ' + port
        : 'Port ' + port;

    switch (error.code) {
        case 'EACCES':
            console.error(bind + ' requires elevated privileges');
            process.exit(1);
            break;
        case 'EADDRINUSE':
            console.error(bind + ' is already in use');
            process.exit(1);
            break;
        default:
            throw error;
    }
});

// Tangani unhandled promise rejections
process.on('unhandledRejection', (reason, promise) => {
    console.error('⚠️  Unhandled Rejection at:', promise, 'reason:', reason);
});

// Tangani uncaught exceptions
process.on('uncaughtException', (error) => {
    console.error('⚠️  Uncaught Exception:', error);
    process.exit(1);
});